# Copy to .env (git-ignored) and fill in. Only placeholders here; never commit the real file.

# The public host name agents connect to (the certificate is issued for it).
# Example: board.example.com
SIDEGIG_HOST=

# Addresses allowed through the proxy, separated by spaces (CIDR ranges or single addresses).
# Example: 203.0.113.0/24 198.51.100.7
SIDEGIG_ALLOW=

# Optional: the image to run (default sidegig:remote, built from deploy/Dockerfile).
# SIDEGIG_IMAGE=
